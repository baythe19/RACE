# Use your PC's LAN IP so a physical phone can reach the backend
EXPO_PUBLIC_API_URL=http://192.168.1.11:3000

# Required for address search + map geocoding (Places + Geocoding APIs enabled)
EXPO_PUBLIC_GOOGLE_MAPS_KEY=your_google_maps_api_key
GOOGLE_MAPS_API_KEY=your_google_maps_api_key

# OTP: backend sends real Twilio SMS for partner login

# Set true only for an intentional local mock walkthrough; failed API mutations otherwise stay failed.
EXPO_PUBLIC_UI_PREVIEW_MUTATIONS=false

# Opt in only when intentionally previewing mock data locally.
EXPO_PUBLIC_UI_PREVIEW_MODE=false
EXPO_PUBLIC_UI_TEST_PERMISSIVE_MODE=false
