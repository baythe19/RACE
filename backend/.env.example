# Server
NODE_ENV=development
PORT=3000
API_PREFIX=/api/v1

# MongoDB Atlas (development) — database name: race
MONGODB_URI=mongodb+srv://<user>:<password>@cluster0.gai795e.mongodb.net/race?retryWrites=true&w=majority

# Redis
REDIS_URL=redis://localhost:6379

# JWT
JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# OTP
OTP_EXPIRY_SECONDS=300
OTP_MAX_RESEND_ATTEMPTS=3
OTP_MAX_VERIFY_ATTEMPTS=5
# Required in production when HANU_API_KEY is set (productionGuard, ≥32 chars)
OTP_PEPPER=change-me-otp-pepper-min-32-chars-long
# Default false — do not enable universal dev OTP on real traffic
MOCK_DATA_MODE=false
# MVP local: allow stub advance/final verify without Razorpay (development only)
ALLOW_STUB_PAYMENTS=true
# HANU_API_KEY=

# CORS
CORS_ORIGIN=*

# Google Cloud Storage (future)
GCS_BUCKET_NAME=
GCS_PROJECT_ID=
GCS_KEY_FILE=

# App — use your PC LAN IP in dev so phone QR scans reach the API (same as EXPO_PUBLIC_API_URL)
APP_BASE_URL=http://192.168.1.7:3000
ADMIN_WEB_URL=http://localhost:3001

# Hardcoded platform admin (not stored in MongoDB)
ADMIN_EMAIL=admin@raceservice.com
ADMIN_PASSWORD=Admin@123
ADMIN_NAME=Admin User

# SMTP (email OTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM=your-email@gmail.com

# HanuSMS Service (Sole production SMS route: api.hanuotp.in)
HANU_API_KEY=
HANU_BASE_URL=https://api.hanuotp.in
HANU_TEMPLATE_ID=default
HANU_OTP_ROLES=customer,vendor,driver,admin
OTP_PEPPER=race-production-otp-pepper-secret-32chars-min

# Payment webhook HMAC (≥32 chars). Required in production (productionGuard).
# Optional in development; when set, unsigned webhooks are rejected.
PAYMENT_WEBHOOK_SECRET=local-dev-webhook-secret-min-32-chars

# Google Maps (distance matrix for towing fare)
GOOGLE_MAPS_API_KEY=PASTE_YOUR_KEY_HERE

# SOS / emergency hotlines (shown in mobile app)
SOS_EMERGENCY_PHONE=+911080808080
SOS_SUPPORT_PHONE=+911800123456
SOS_AVG_ARRIVAL_MINUTES=25

# QA test accounts (APK testing): fake 9000000xxx numbers verify against
# MOCK_UNIVERSAL_OTP without a real SMS. Real numbers keep full HanuSMS OTP.
TEST_OTP_WHITELIST=9000000000,9000000001,9000000002,9000000003,9000000004,9000000005,9000000006,9000000007,9876543210
