{
  "name": "race-backend",
  "version": "1.0.0",
  "private": true,
  "description": "RACE Service — production backend API",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "seed": "tsx src/database/src/seed.ts",
    "seed:mock": "tsx src/database/src/seed-mock-data.ts",
    "seed:fresh": "tsx src/scripts/reset-for-testing.ts && tsx src/database/src/seed-mock-data.ts",
    "seed:demo-drivers": "tsx src/database/src/seed-demo-drivers.ts",
    "seed:reset": "tsx src/database/src/seed.ts",
    "db:reset": "tsx src/database/src/reset.ts && tsx src/database/src/seed.ts",
    "regenerate-vehicle-qrs": "tsx src/scripts/regenerate-vehicle-qrs.ts",
    "migrate:unified-users": "tsx src/database/src/migrate-unified-users.ts",
    "reset-test-data": "tsx src/scripts/reset-for-testing.ts",
    "lint": "tsc --noEmit",
    "audit:partner-v6": "tsx src/scripts/partner-v6-offer-routing-audit.ts",
    "seed:test-accounts": "tsx src/scripts/seed-test-accounts.ts",
    "ensure:test-accounts": "tsx src/scripts/ensure-test-accounts.ts",
    "smoke:render": "tsx src/scripts/verify-render-tier-b-smoke.ts",
    "mvp:smoke": "tsx src/scripts/mvp-local-smoke.ts"
  },
  "dependencies": {
    "@google-cloud/storage": "^7.21.0",
    "@socket.io/redis-adapter": "^8.3.0",
    "bcryptjs": "^3.0.3",
    "compression": "^1.8.0",
    "cors": "^2.8.5",
    "dotenv": "^16.5.0",
    "express": "^5.1.0",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.1.0",
    "ioredis": "^5.6.1",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.15.1",
    "morgan": "^1.10.0",
    "multer": "^2.2.0",
    "nodemailer": "^7.0.13",
    "qrcode": "^1.5.4",
    "socket.io": "^4.8.3",
    "twilio": "^6.0.2",
    "uuid": "^11.1.0",
    "zod": "^3.25.42"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/compression": "^1.7.5",
    "@types/cors": "^2.8.18",
    "@types/express": "^5.0.2",
    "@types/jsonwebtoken": "^9.0.9",
    "@types/morgan": "^1.9.9",
    "@types/multer": "^2.1.0",
    "@types/node": "^22.15.21",
    "@types/nodemailer": "^6.4.24",
    "@types/qrcode": "^1.5.5",
    "@types/socket.io": "^3.0.1",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
