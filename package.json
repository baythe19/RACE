{
  "name": "race",
  "version": "2.0.1",
  "private": true,
  "description": "RACE Service — customer app, partner app, admin, backend",
  "scripts": {
    "dev:backend": "cd backend && npm run dev",
    "dev:admin": "cd race-admin && npm run dev",
    "dev:customer": "cd \"customer application\" && npm start",
    "dev:partner": "cd \"mobile application\" && npm start",
    "seed": "cd backend && npm run seed",
    "seed:backend": "cd backend && npm run seed",
    "test:ui-on": "bash scripts/toggle-ui-test-mode.sh on",
    "test:ui-off": "bash scripts/toggle-ui-test-mode.sh off",
    "test:ui-status": "bash scripts/toggle-ui-test-mode.sh status"
  }
}
